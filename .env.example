# Base de données PostgreSQL
DATABASE_URL="postgresql://docdrive:password@localhost:5432/docdrive"

# NextAuth — générer avec: openssl rand -base64 32
AUTH_SECRET="CHANGEZ_MOI_openssl_rand_base64_32"

# URL de l'application
NEXTAUTH_URL="http://localhost:3000"

# Stockage fichiers
# Choisir LOCAL ou R2

# --- Option 1: Stockage local (développement) ---
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./uploads"

# --- Option 2: Cloudflare R2 (production) ---
# STORAGE_PROVIDER="r2"
# R2_ACCOUNT_ID="votre_account_id"
# R2_ACCESS_KEY_ID="votre_access_key"
# R2_SECRET_ACCESS_KEY="votre_secret_key"
# R2_BUCKET_NAME="docdrive-docs"
# R2_PUBLIC_URL="https://votre-bucket.r2.dev"

# Taille max upload (en MB)
MAX_FILE_SIZE_MB="50"
